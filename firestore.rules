rules_version = '2';

// ── DineAtNight Firestore Security Rules ─────────────────────────────────────
//
// Deploy: firebase deploy --only firestore:rules
//
// Trust model:
// - All server-side writes (payments, subscribers, rate limits) use the
//   Firebase Admin SDK (lib/firebase-admin.ts), which bypasses these rules.
//   So nothing here needs to allow unauthenticated writes for the server.
// - Admin panel writes use the client SDK and require isAdmin().
// - The public may only: read public content, create a vendor application,
//   create a pending testimonial, and get a single ticket by its reference.
//
// Keep ADMINS in sync with ADMIN_EMAILS (Vercel) and storage.rules.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          "admin@dineatnight.com",
          "tami@dineatnight.com",
          "temi@dineatnight.com",
          "ajibola@dineatnight.com",
          "zena@dineatnight.com"
        ];
    }

    // ── Events ───────────────────────────────────────────────────────────────
    // soldTickets is incremented server-side (Admin SDK) on payment.
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Vendors ──────────────────────────────────────────────────────────────
    // Vendor docs contain private contact details (email, phone, owner name),
    // so only admins can read them. The public site gets approved vendors,
    // public fields only, from GET /api/vendors (Admin SDK).
    // Public can submit a new application (status must be "pending");
    // only admins can edit, approve or delete.
    match /vendors/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        || (request.resource.data.status == "pending"
            && request.resource.data.keys().hasAll(["brandName", "ownerName", "email", "status"])
            && request.resource.data.keys().hasOnly([
                 "brandName", "brandNameLower", "ownerName", "email", "phone", "instagram",
                 "category", "categories", "events", "description", "products",
                 "logoUrl", "imageUrl", "imageUrls", "menu", "menuImages", "productImages",
                 "status", "submittedAt", "reviewedAt"
               ])
            && request.resource.data.brandName is string
            && request.resource.data.brandName.size() <= 100
            && request.resource.data.description is string
            && request.resource.data.description.size() <= 5000
            && request.resource.data.get("menuImages", []).size() <= 6
            && request.resource.data.get("productImages", []).size() <= 6);
      allow update, delete: if isAdmin();
    }

    // ── Gallery ──────────────────────────────────────────────────────────────
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Testimonials ─────────────────────────────────────────────────────────
    // Public read stays open because the public section queries the whole
    // collection (rules are not filters). Pending quotes are low-sensitivity.
    match /testimonials/{id} {
      allow read: if true;
      allow create: if isAdmin()
        || (request.resource.data.approved == false
            && request.resource.data.createdBy == "user"
            && request.resource.data.keys().hasAll(["name", "quote", "type"])
            && request.resource.data.keys().hasOnly([
                 "name", "type", "role", "quote", "eventTitle", "createdBy", "approved", "submittedAt"
               ])
            && request.resource.data.type in ["vendor", "user"]
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 100
            && request.resource.data.quote is string
            && request.resource.data.quote.size() <= 2000);
      allow update, delete: if isAdmin();
    }

    // ── Products (merch shop) ────────────────────────────────────────────────
    // soldCount is incremented server-side (Admin SDK) on payment.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Tickets ──────────────────────────────────────────────────────────────
    // Created and marked paid server-side only. The public ticket page may
    // fetch ONE ticket by reference (the reference is the bearer token) but
    // can never list the collection.
    match /tickets/{reference} {
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin(); // gate check-in, admin edits
      allow create: if false;
    }

    // ── Merch orders ─────────────────────────────────────────────────────────
    match /merch_orders/{reference} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // ── Subscribers ──────────────────────────────────────────────────────────
    // Created by /api/subscribe and deleted by /api/unsubscribe (Admin SDK).
    match /subscribers/{email} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // ── Server-only ──────────────────────────────────────────────────────────
    match /rate_limits/{id} {
      allow read, write: if false;
    }

    // ── Admin-only collections ───────────────────────────────────────────────
    match /admin_logs/{id} {
      allow read, write: if isAdmin();
    }
    match /suppressed_emails/{email} {
      allow read, write: if isAdmin();
    }
    match /newsletters/{id} {
      allow read, write: if isAdmin();
    }
    match /deleted_events/{id} {
      allow read, write: if isAdmin();
    }
    match /deleted_products/{id} {
      allow read, write: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
