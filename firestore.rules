rules_version = '2';

// ── DineAtNight Firestore Security Rules ─────────────────────────────────────
//
// Deploy: firebase deploy --only firestore:rules
//
// Architecture note:
// Public-facing reads use the client SDK directly (events, vendors, etc.).
// Payment writes (tickets, merch_orders) use the client SDK from server API
// routes — those routes run server-side with no Firebase Auth context.
// Until those routes are migrated to the Firebase Admin SDK (which bypasses
// rules), the write rules below reflect the current trusted-server model.
//
// rate_limits: written by the server-side rate limiter (lib/rateLimit.ts).
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Events ───────────────────────────────────────────────────────────────
    // Public read. Admin writes go through API routes (no direct client writes).
    // Exception: payment verification routes (unauthenticated server) update
    // soldTickets only — allowed via the narrow field check below.
    match /events/{id} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if request.auth != null
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['soldTickets']);
    }

    // ── Vendors ──────────────────────────────────────────────────────────────
    // Public read for approved vendors only. Unapproved applications are hidden.
    // Writes come from the vendor application form (public) and admin panel (auth).
    match /vendors/{id} {
      allow read: if resource.data.status == "approved" || request.auth != null;
      // Allow public create for new vendor applications (phone is optional)
      allow create: if request.resource.data.keys().hasAll(["brandName", "ownerName", "email", "status"])
                    && request.resource.data.status == "pending";
      // Allow admins OR public re-applications (setting status back to pending)
      allow update: if request.auth != null
                    || request.resource.data.status == "pending";
      allow delete: if request.auth != null;
    }

    // ── Gallery ──────────────────────────────────────────────────────────────
    match /gallery/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Testimonials ─────────────────────────────────────────────────────────
    // Public read for approved testimonials only.
    match /testimonials/{id} {
      allow read: if resource.data.approved == true;
      // Allow public create for user submissions
      allow create: if request.resource.data.keys().hasAll(["name", "quote", "type"])
                    && request.resource.data.approved == false;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── Products (Merch shop) ─────────────────────────────────────────────────
    // Public read for active products. No direct client writes.
    match /products/{id} {
      allow read: if resource.data.active != false;
      allow write: if request.auth != null;
    }

    // ── Subscribers ──────────────────────────────────────────────────────────
    // Newsletter signups. Written by the server-side /api/subscribe route via
    // the public Firestore REST API. Only authenticated admins can read.
    match /subscribers/{email} {
      allow read: if request.auth != null;
      allow write: if request.resource.data.keys().hasOnly(["email", "subscribedAt"])
                   && request.resource.data.email is string
                   && request.resource.data.email.size() > 3
                   && request.resource.data.email.size() < 255;
    }

    // ── Tickets ───────────────────────────────────────────────────────────────
    // Created and updated by server API routes (/api/paystack/*).
    // Readable by authenticated admins (admin panel) and by anyone who knows
    // the reference (ticket page — reference is the doc ID).
    // TODO: migrate payment API routes to Firebase Admin SDK, then tighten to:
    //   allow write: if request.auth != null;
    match /tickets/{reference} {
      allow read: if true;   // public read — reference is the access token
      allow create: if true; // server creates pending tickets
      allow update: if true; // server marks tickets paid/confirmed
      allow delete: if request.auth != null;
    }

    // ── Merch Orders ─────────────────────────────────────────────────────────
    // Created and updated by server API routes (/api/paystack/merch/*).
    // TODO: migrate to Admin SDK, then tighten write rules.
    match /merch_orders/{reference} {
      allow read: if request.auth != null; // admin only
      allow create: if true; // server creates pending orders
      allow update: if true; // server marks orders paid
      allow delete: if request.auth != null;
    }

    // ── Admin Logs ───────────────────────────────────────────────────────────
    // Written and read by authenticated admin clients.
    match /admin_logs/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Rate Limits ──────────────────────────────────────────────────────────
    // Written by the server-side rate limiter (lib/rateLimit.ts). The client
    // SDK is used server-side, so rules apply. Allow read+write without auth
    // since the rate limiter runs in unauthenticated server routes.
    match /rate_limits/{id} {
      allow read, write: if true;
    }

    // ── Suppressed emails (marketing opt-out / admin remove) ─────────────────
    match /suppressed_emails/{email} {
      allow read, write: if request.auth != null;
    }

    // ── Newsletters (sent history) ────────────────────────────────────────────
    match /newsletters/{id} {
      allow read, write: if request.auth != null;
    }

    // ── Deleted archives (soft-delete) ────────────────────────────────────────
    match /deleted_events/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /deleted_products/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
