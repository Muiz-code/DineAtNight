rules_version = '2';

// ── DineAtNight Firebase Storage Security Rules ───────────────────────────────
//
// Deploy: firebase deploy --only storage
//
// Folder structure:
//   /vendors/*      — vendor logo and food images (public application form)
//   /events/*, /sponsors/*, /gallery/*, /products/*, /testimonials/* — admin only
//
// Keep the admin list in sync with ADMIN_EMAILS (Vercel) and firestore.rules.
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          "admin@dineatnight.com",
          "tami@dineatnight.com",
          "temi@dineatnight.com",
          "ajibola@dineatnight.com",
          "zena@dineatnight.com"
        ];
    }

    function isImageUnder(mb) {
      return request.resource.size <= mb * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    // ── Vendor images ─────────────────────────────────────────────────────────
    // Public create only (the upload component uses random file names), so an
    // existing vendor's images can never be overwritten or deleted publicly.
    match /vendors/{allPaths=**} {
      allow read: if true;
      allow create: if isImageUnder(10);
      allow update, delete: if isAdmin();
    }

    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || isImageUnder(10));
    }

    match /sponsors/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || isImageUnder(5));
    }

    // Photos and videos
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && (request.resource == null
            || (request.resource.size <= 200 * 1024 * 1024
                && (request.resource.contentType.matches("image/.*")
                    || request.resource.contentType.matches("video/.*"))));
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || isImageUnder(10));
    }

    match /testimonials/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || isImageUnder(5));
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
